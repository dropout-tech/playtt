{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1180px", "wideSize": "1280px" },
    "color": { "defaultPalette": false, "palette": [
      { "slug": "blue", "name": "品牌藍", "color": "#005CB9" },
      { "slug": "yellow", "name": "活力黃", "color": "#FFD900" },
      { "slug": "green", "name": "玩樂綠", "color": "#38D430" },
      { "slug": "pink", "name": "品牌桃紅", "color": "#FF32AD" },
      { "slug": "ink", "name": "墨色", "color": "#142B41" },
      { "slug": "paper", "name": "淺灰", "color": "#F5F6F6" },
      { "slug": "white", "name": "純白", "color": "#FFFFFF" }
    ] },
    "typography": {
      "fluid": true,
      "fontFamilies": [{ "slug": "sans", "name": "品牌黑體", "fontFamily": "\"Noto Sans TC\",\"PingFang TC\",\"Microsoft JhengHei\",sans-serif" }],
      "fontSizes": [
        { "slug": "small", "name": "小字", "size": "14px" },
        { "slug": "body", "name": "內文", "size": "16px" },
        { "slug": "large", "name": "標題", "size": "32px" },
        { "slug": "hero", "name": "主視覺", "size": "64px", "fluid": {"min":"42px","max":"78px"} }
      ]
    },
    "spacing": { "units": ["px","rem","%","vw"], "blockGap": true }
  },
  "styles": {
    "color": {"background":"var:preset|color|paper","text":"var:preset|color|ink"},
    "typography": {"fontFamily":"var:preset|font-family|sans","fontSize":"16px","lineHeight":"1.75"},
    "spacing": {"blockGap":"24px"},
    "elements": {
      "heading": {"typography":{"fontWeight":"800","lineHeight":"1.3"}},
      "link": {"color":{"text":"var:preset|color|blue"}},
      "button": {"color":{"background":"var:preset|color|blue","text":"var:preset|color|white"},"border":{"radius":"0"}}
    }
  },
  "templateParts": [
    {"name":"header","title":"品牌頁首","area":"header"},
    {"name":"footer","title":"品牌頁尾","area":"footer"}
  ]
}
