{
  "name": "playtt-wp-free-local-probe",
  "main": "src/worker-do.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 10 },
  "r2_buckets": [{ "binding": "WORDPRESS_STATE_BUCKET", "bucket_name": "wp-codebox-runtime-chubes" }],
  "durable_objects": { "bindings": [{ "name": "WORDPRESS_STATE", "class_name": "WordPressStateCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WordPressStateCoordinator"] }],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Data", "globs": ["**/*.sqlite", "**/*-runtime.zip", "**/*-canonical-seed.zip"], "fallthrough": false }
  ],
  "vars": {
    "WORDPRESS_ADMIN_PASSWORD": "playtt-local-probe-only-password",
    "WORDPRESS_ADMIN_CLAIM_SECRET": "playtt-local-probe-only-claim-secret-32bytes",
    "WORDPRESS_AUTH_SECRET": "playtt-local-probe-only-auth-secret-32bytes",
    "WORDPRESS_OPERATOR_TOKEN": "playtt-local-probe-only-operator",
    "WORDPRESS_SITE_CONTEXTS": "[{\"id\":\"default\",\"hostname\":\"127.0.0.1\",\"origin\":\"http://127.0.0.1:9426\"}]"
  }
}
