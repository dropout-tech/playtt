+export type PlayttMaintenanceAction = 'preview' | 'run';
+export const PLAYTT_AUTO_DRAFT_BATCH = 20;
+
+export async function preparePlayttMaintenanceRequest(request: Request, authorized: () => Promise<boolean>): Promise<Request | Response> {
+  const headers = { 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex, nofollow' };
+  if (request.method !== 'POST') return new Response('Maintenance requires POST.', { status: 405, headers });
+  if (!await authorized()) return new Response('Maintenance authorization failed.', { status: 401, headers });
+  let action: PlayttMaintenanceAction;
+  try { action = await readPlayttMaintenanceAction(request); }
+  catch { return new Response('Maintenance input is invalid.', { status: 400, headers }); }
+  const forwardedHeaders = new Headers(request.headers);
+  forwardedHeaders.delete('content-length');
+  return new Request(request, { headers: forwardedHeaders, body: JSON.stringify({ action }) });
+}
+
+export async function readPlayttMaintenanceAction(request: Request): Promise<PlayttMaintenanceAction> {
+  if (request.method !== 'POST') throw new Error('Maintenance requires POST.');
+  if (request.headers.get('content-type')?.split(';')[0].trim() !== 'application/json') throw new Error('Maintenance requires JSON.');
+  const reader = request.body?.getReader();
+  if (!reader) throw new Error('Maintenance input is invalid.');
+  const chunks: Uint8Array[] = []; let size = 0;
+  try {
+    while (true) {
+      const {done,value} = await reader.read(); if (done) break;
+      size += value.byteLength;
+      if (size > 256) { await reader.cancel(); throw new Error('Maintenance input is oversized.'); }
+      chunks.push(value);
+    }
+  } finally { reader.releaseLock(); }
+  const bytes = new Uint8Array(size); let offset = 0;
+  for (const chunk of chunks) { bytes.set(chunk,offset); offset += chunk.length; }
+  const input = JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));
+  if (!input || typeof input !== 'object' || Array.isArray(input) || Object.keys(input).length !== 1 || !['preview','run'].includes(input.action)) throw new Error('Maintenance input is invalid.');
+  return input.action;
+}
+
+export function playttAutoDraftMaintenanceCode(action: PlayttMaintenanceAction): string {
+  if (!['preview','run'].includes(action)) throw new Error('Maintenance action is invalid.');
+  return `<?php
+require '/wordpress/wp-load.php';
+global $wpdb;
+$apply = ${action === 'run' ? 'true' : 'false'};
+// Use the pinned core function's exact eligibility rule. Never accept IDs,
+// dates, ages or a general cron hook from the caller.
+$eligibility = "post_status = 'auto-draft' AND DATE_SUB( NOW(), INTERVAL 7 DAY ) > post_date";
+$native_query = "SELECT ID FROM $wpdb->posts WHERE " . $eligibility;
+$count_query = "SELECT COUNT(*) FROM $wpdb->posts WHERE " . $eligibility;
+$eligible_before = (int) $wpdb->get_var($count_query);
+if ($wpdb->last_error) throw new RuntimeException('Auto-draft inventory failed.');
+$selected = array_map('intval', $wpdb->get_col($native_query . ' ORDER BY ID ASC LIMIT ${PLAYTT_AUTO_DRAFT_BATCH}'));
+if ($wpdb->last_error || count($selected) > ${PLAYTT_AUTO_DRAFT_BATCH} || count(array_filter($selected, static fn($id) => $id <= 0))) throw new RuntimeException('Auto-draft selection failed.');
+$deleted = array();
+if ($apply && $selected) {
+    $intercepted = 0;
+    // Core still rechecks status/date and performs its normal deletion hooks.
+    // Restrict its one selection to this bounded, internally selected batch.
+    $bound = static function($query) use ($native_query, $selected, &$intercepted) {
+        if ($query !== $native_query) return $query;
+        $intercepted++;
+        return $query . ' AND ID IN (' . implode(',', $selected) . ')';
+    };
+    add_filter('query', $bound, PHP_INT_MAX);
+    try { wp_delete_auto_drafts(); }
+    finally { remove_filter('query', $bound, PHP_INT_MAX); }
+    if ($intercepted !== 1) throw new RuntimeException('Pinned auto-draft cleanup query changed.');
+    foreach ($selected as $id) if (null === get_post($id)) $deleted[] = $id;
+}
+$remaining = (int) $wpdb->get_var($count_query);
+if ($wpdb->last_error) throw new RuntimeException('Auto-draft readback failed.');
+$wpdb->flush_canonical_writes();
+echo json_encode(array('schema'=>'playtt/auto-draft-maintenance/v1','action'=>${JSON.stringify(action)},'batchLimit'=>${PLAYTT_AUTO_DRAFT_BATCH},'eligibleBefore'=>$eligible_before,'selectedIds'=>$selected,'deletedIds'=>$deleted,'remainingEligible'=>$remaining,'skippedIds'=>$apply ? array_values(array_diff($selected,$deleted)) : array()), JSON_THROW_ON_ERROR);`;
+}
+
+export function validatePlayttMaintenanceResult(value: unknown, action: PlayttMaintenanceAction): void {
+  const r = value as Record<string,unknown>;
+  if (!r || r.schema !== 'playtt/auto-draft-maintenance/v1' || r.action !== action || r.batchLimit !== PLAYTT_AUTO_DRAFT_BATCH) throw new Error('Maintenance result is invalid.');
+  for (const field of ['eligibleBefore','remainingEligible']) if (!Number.isSafeInteger(r[field]) || (r[field] as number) < 0) throw new Error('Maintenance count is invalid.');
+  for (const field of ['selectedIds','deletedIds','skippedIds']) {
+    const ids = r[field];
+    if (!Array.isArray(ids) || ids.length > PLAYTT_AUTO_DRAFT_BATCH || new Set(ids).size !== ids.length || ids.some(id=>!Number.isSafeInteger(id)||id<=0)) throw new Error('Maintenance IDs are invalid.');
+  }
+  const selected = r.selectedIds as number[], deleted = r.deletedIds as number[], skipped = r.skippedIds as number[];
+  if (selected.length > (r.eligibleBefore as number) || [...deleted,...skipped].some(id=>!selected.includes(id)) || deleted.some(id=>skipped.includes(id))) throw new Error('Maintenance result does not match its batch.');
+  if (action === 'preview' ? deleted.length || skipped.length || r.eligibleBefore !== r.remainingEligible : deleted.length + skipped.length !== selected.length) throw new Error('Maintenance action result is inconsistent.');
+}
