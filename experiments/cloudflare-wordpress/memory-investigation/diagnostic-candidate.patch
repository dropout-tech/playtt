+function logPlayttRuntimeMemory(stage: string, runtime: Runtime, env: RuntimeEnv): void {
+  if ((env as RuntimeEnv & { PLAYTT_MEMORY_DIAGNOSTICS?: string }).PLAYTT_MEMORY_DIAGNOSTICS !== 'true') return
+  const key = Object.getOwnPropertySymbols(runtime.php).find(symbol => symbol.description === '__private__dont__use')
+  const module = key ? (runtime.php as unknown as Record<symbol, any>)[key] : undefined
+  let fileBytes = 0, files = 0
+  function visit(node: any): void {
+    if (node?.contents instanceof Uint8Array) { fileBytes += node.contents.byteLength; files++ }
+    else if (node?.contents && typeof node.contents === 'object') for (const child of Object.values(node.contents)) visit(child)
+  }
+  visit(module?.FS?.root)
+  console.log(JSON.stringify({ schema: 'playtt-runtime-memory/v1', stage, heapBytes: module?.HEAPU8?.byteLength || 0, fileBytes, files }))
+}
