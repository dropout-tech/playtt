+import { MAX_RESTORE_PACK_DECODED_BYTES, readCanonicalRestorePack, type CanonicalRestorePackFile, type CanonicalRestorePackMetadata, type RestorePackBucket, type RestorePackContents } from './canonical-restore-pack.js';
+
+export interface PlayttSnapshotManifest {
+  files: CanonicalRestorePackFile[];
+  uploads?: CanonicalRestorePackFile[];
+  wpContent?: CanonicalRestorePackFile[];
+  wpContentDeleted?: string[];
+  restorePack?: CanonicalRestorePackMetadata;
+}
+
+type Group = 'markdown' | 'uploads' | 'wpContent';
+const groups = ['markdown', 'uploads', 'wpContent'] as const;
+const prefixes = { markdown: 'markdown', uploads: 'uploads', wpContent: 'wp-content' } as const;
+const filesOf = (manifest: PlayttSnapshotManifest, group: Group) => group === 'markdown' ? manifest.files : manifest[group] || [];
+
+function validateSources(root: string, manifest: PlayttSnapshotManifest): void {
+  if (!/^sites\/[a-z0-9_-]{1,128}$/i.test(root)) throw new Error('Snapshot source root is invalid.');
+  let count = 0, bytes = 0;
+  for (const group of groups) {
+    const seen = new Set<string>();
+    for (const file of filesOf(manifest, group)) {
+      if (typeof file.path !== 'string' || !file.path || file.path.includes('\\') || file.path.includes('\0')
+        || file.path.split('/').some(part => !part || part === '.' || part === '..') || seen.has(file.path)
+        || !/^[a-f0-9]{64}$/.test(file.sha256) || !Number.isSafeInteger(file.size) || file.size < 0
+        || file.objectKey !== `${root}/${prefixes[group]}/objects/${file.sha256}`) throw new Error('Snapshot source metadata is invalid.');
+      seen.add(file.path); count++; bytes += file.size;
+    }
+  }
+  if (count > 10_000 || bytes > MAX_RESTORE_PACK_DECODED_BYTES) throw new Error('Snapshot source exceeds its bounded inventory.');
+}
+
+// Unchanged bytes come from the verified, committed R2 pack already used by
+// cold boot. New bytes must be independently read and verified from R2. This
+// does not recheck the availability of unchanged loose-object replicas.
+export async function readPlayttSnapshotSources(bucket: RestorePackBucket, root: string, next: PlayttSnapshotManifest, previous?: PlayttSnapshotManifest | null): Promise<{ contents: RestorePackContents; reusedFiles: number; objectReads: number; basePackRead: boolean }> {
+  validateSources(root, next);
+  if (previous) validateSources(root, previous);
+  const result: RestorePackContents = { markdown: [], uploads: [], wpContent: [], wpContentDeleted: [...(next.wpContentDeleted || [])] };
+  const tasks: Array<{ group: Group; index: number; file: CanonicalRestorePackFile; reuse: boolean }> = [];
+  let reusedFiles = 0;
+  for (const group of groups) {
+    const old = new Map(filesOf(previous || { files: [] }, group).map(file => [file.path, file]));
+    filesOf(next, group).forEach((file, index) => {
+      const before = old.get(file.path);
+      const reuse = !!previous?.restorePack && before?.sha256 === file.sha256 && before.size === file.size;
+      if (reuse) reusedFiles++;
+      tasks.push({ group, index, file, reuse });
+    });
+  }
+  if (reusedFiles) {
+    const contents = await readCanonicalRestorePack(bucket, previous!.restorePack!, root, {
+      markdown: previous!.files, uploads: previous!.uploads || [], wpContent: previous!.wpContent || [], wpContentDeleted: previous!.wpContentDeleted || [],
+    });
+    for (const group of groups) {
+      const verified = new Map(contents[group].map(file => [file.path, file]));
+      for (const task of tasks.filter(task => task.group === group && task.reuse)) {
+        const file = verified.get(task.file.path);
+        if (!file || file.bytes.byteLength !== task.file.size) throw new Error('Verified snapshot source is incomplete.');
+        result[group][task.index] = file;
+      }
+    }
+  }
+  const pending = tasks.filter(task => !task.reuse);
+  let cursor = 0, failed = false;
+  const run = async () => {
+    while (!failed && cursor < pending.length) {
+      const task = pending[cursor++];
+      try {
+        const object = await bucket.get(task.file.objectKey);
+        if (!object || object.size !== task.file.size) throw new Error('Changed snapshot source is missing or has an invalid size.');
+        const bytes = new Uint8Array(await object.arrayBuffer());
+        const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
+        const hash = Array.from(digest, byte => byte.toString(16).padStart(2, '0')).join('');
+        if (bytes.byteLength !== task.file.size || hash !== task.file.sha256) throw new Error('Changed snapshot source failed integrity validation.');
+        result[task.group][task.index] = { path: task.file.path, bytes };
+      } catch (error) { failed = true; throw error; }
+    }
+  };
+  const outcomes = await Promise.allSettled(Array.from({ length: Math.min(6, pending.length) }, run));
+  const rejected = outcomes.find((outcome): outcome is PromiseRejectedResult => outcome.status === 'rejected');
+  if (rejected) throw rejected.reason;
+  return { contents: result, reusedFiles, objectReads: pending.length, basePackRead: reusedFiles > 0 };
+}
