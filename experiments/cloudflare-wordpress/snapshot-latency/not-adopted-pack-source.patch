 // Isolated probe only: emit bounded phase names, never request data or secrets.
 export function enablePlayttPhaseDiagnostics(): void {
   playttPhaseDiagnostics = true
+}
+
+// I/O-bounded wall intervals, not CPU timings: remote clocks advance on I/O.
+export function logPlayttSnapshotPhase(stage: 'read-and-verify' | 'encode-and-upload' | 'manifest-upload', startedAt: number, files: number, bytes: number, sources?: { reusedFiles: number; objectReads: number; basePackRead: boolean }): number {
+  const now = defaultNow()
+  if (playttPhaseDiagnostics) console.log(JSON.stringify({ schema: 'playtt-snapshot-phase/v1', stage, durationMs: boundedMs(now - startedAt), ...boundedEvidence({ files, bytes, ...sources }) }))
+  return now
 }
 
