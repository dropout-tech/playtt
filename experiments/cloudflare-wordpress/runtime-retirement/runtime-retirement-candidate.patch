@@ -0,0 +1,18 @@
+import type { PHP } from '@php-wasm/universal';
+
+// The pinned MDI package deliberately drops auto-drafts as ephemeral. In a
+// runtime rebuilt between editor requests, their IDs must survive until the
+// user saves or discards them. Preserve native status, content and permissions.
+export function patchPlayttAutoDraftPersistence(php: PHP): void {
+  const root='/wordpress/wp-content/plugins/markdown-database-integration/inc/';
+  const patches=[
+    {file:'class-wp-markdown-write-engine.php',needle:'$id && ! $this->is_auto_draft( (int) $id )',replacement:'$id /* PLAYTT_PERSIST_AUTO_DRAFT */'},
+    {file:'class-wp-markdown-storage.php',needle:"\t\tif ( 'auto-draft' === $status ) {\n\t\t\treturn false;\n\t\t}",replacement:'\t\t// PLAYTT_PERSIST_AUTO_DRAFT: keep native status across runtime retirement.'},
+  ];
+  for(const patch of patches){
+    const path=root+patch.file,source=new TextDecoder().decode(php.readFileAsBuffer(path));
+    const index=source.indexOf(patch.needle);
+    if(index<0||index!==source.lastIndexOf(patch.needle))throw new Error('Pinned MDI auto-draft policy needle is not unique: '+patch.file);
+    php.writeFile(path,new TextEncoder().encode(source.slice(0,index)+patch.replacement+source.slice(index+patch.needle.length)));
+  }
+}
