@@ -0,0 +1,18 @@
+import type { PHP } from '@php-wasm/universal';
+
+// Release between fully committed HTTP/alarm operations, before the upstream
+// 400-request hot swap has to keep both complete PHP runtimes alive at once.
+// The WeakMap and event listener do not retain a disposed PHP instance.
+const lifetime=new WeakMap<PHP,{requests:number}>();
+export function trackPlayttRuntimeLifetime(php: PHP): void {
+  if(lifetime.has(php))return;
+  const state={requests:0};lifetime.set(php,state);
+  php.addEventListener('request.end',()=>{state.requests++;});
+}
+export function playttRuntimeRetirement(php: PHP): {requests:number;heapBytes:number;due:boolean} {
+  const requests=lifetime.get(php)?.requests||0;
+  const key=Object.getOwnPropertySymbols(php).find(s=>s.description==='__private__dont__use');
+  const module=key?(php as unknown as Record<symbol,any>)[key]:undefined;
+  const heapBytes=module?.HEAPU8?.byteLength||0;
+  return {requests,heapBytes,due:requests>=96||heapBytes>=76*1024*1024};
+}
