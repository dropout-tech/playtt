{
  "name": "playtt-wp-free-cms-local-fresh",
  "main": "src/worker-playtt-do.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "WORDPRESS_STATE_BUCKET",
      "bucket_name": "playtt-wordpress-probe"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORDPRESS_STATE",
        "class_name": "WordPressStateCoordinator"
      },
      {
        "name": "PLAYTT_EXECUTION",
        "class_name": "PlayttWordPressExecution"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WordPressStateCoordinator",
        "PlayttWordPressExecution"
      ]
    }
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": false
    },
    {
      "type": "Data",
      "globs": [
        "**/*.sqlite",
        "**/*-runtime.zip",
        "**/*-canonical-seed.zip"
      ],
      "fallthrough": false
    }
  ],
  "vars": {
    "WORDPRESS_ADMIN_PASSWORD": "playtt-cms-local-only-password",
    "WORDPRESS_ADMIN_CLAIM_SECRET": "playtt-cms-local-only-claim-secret-32bytes",
    "WORDPRESS_AUTH_SECRET": "playtt-cms-local-only-auth-secret-32bytes",
    "WORDPRESS_OPERATOR_TOKEN": "playtt-cms-local-only-operator",
    "WORDPRESS_SITE_CONTEXTS": "[{\"id\":\"default\",\"hostname\":\"127.0.0.1\",\"origin\":\"http://127.0.0.1:9429\"}]"
  }
}
