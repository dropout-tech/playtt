@@ -0,0 +1,35 @@
+export const MAX_PLAYTT_PUBLICATION_BATCH = 32;
+export interface PublicationChanges { all: boolean; upsert: string[]; remove: string[] }
+export interface PublicationCandidate {
+  key: string;
+  version: number;
+  committed: boolean;
+  changes: PublicationChanges;
+}
+
+// Input is the bounded oldest-first R2 outbox window, verified against exact
+// coordinator receipts while holding the revision lease. Never cross an
+// uncommitted job: let the existing orphan/pending path resolve it first.
+export function selectPublicationBatch(jobs: PublicationCandidate[], publishedVersion: number): { key: string; changes?: PublicationChanges } | null {
+  if (!jobs.length) return null;
+  if (jobs.length > MAX_PLAYTT_PUBLICATION_BATCH || jobs.some((job, i) => !Number.isSafeInteger(job.version) || job.version < 1 || (i > 0 && job.version <= jobs[i - 1].version))) {
+    throw new Error('Publication batch must be bounded and strictly ordered.');
+  }
+  const first = jobs[0];
+  if (!first.committed || first.version <= publishedVersion) return { key: first.key };
+  const operations = new Map<string, 'upsert' | 'remove'>();
+  let all = false, key = first.key;
+  for (const job of jobs) {
+    if (!job.committed) break;
+    key = job.key;
+    all ||= job.changes.all;
+    // A job's existing publicationPlan gives upsert precedence on overlap.
+    for (const route of job.changes.remove) operations.set(route, 'remove');
+    for (const route of job.changes.upsert) operations.set(route, 'upsert');
+  }
+  return { key, changes: {
+    all,
+    upsert: [...operations].filter(([, operation]) => operation === 'upsert').map(([route]) => route).sort(),
+    remove: [...operations].filter(([, operation]) => operation === 'remove').map(([route]) => route).sort(),
+  } };
+}
