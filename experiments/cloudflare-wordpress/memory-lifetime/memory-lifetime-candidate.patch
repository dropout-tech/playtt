+import type { PHP } from '@php-wasm/universal';
+
+// The pinned Emscripten MEMFS doubles small file capacities during ZIP
+// extraction. Core PHP source is immutable after our boot patches; retain
+// exactly its used bytes instead of the unused growth capacity. Never touch
+// canonical wp-content, uploads, database files or WASM-aliased buffers.
+export function compactPlayttCoreFiles(php: PHP): { files: number; beforeBytes: number; afterBytes: number; releasedCapacityBytes: number } {
+  const key=Object.getOwnPropertySymbols(php).find(symbol=>symbol.description==='__private__dont__use');
+  const module=key?(php as unknown as Record<symbol,any>)[key]:undefined;
+  const root=module?.FS?.root?.contents?.wordpress;
+  if(!root)throw new Error('Pinned PHP MEMFS core root is unavailable.');
+  const result={files:0,beforeBytes:0,afterBytes:0,releasedCapacityBytes:0};
+  const seen=new Set<object>();
+  function visit(node:any,path:string):void {
+    if(!node||seen.has(node)||path==='/wordpress/wp-content')return;
+    seen.add(node);
+    const bytes=node.contents;
+    if(ArrayBuffer.isView(bytes)&&(bytes as any).BYTES_PER_ELEMENT===1){
+      result.beforeBytes+=bytes.byteLength;
+      if(Number.isSafeInteger(node.usedBytes)&&node.usedBytes>=0&&node.usedBytes<bytes.byteLength&&bytes.buffer!==module.HEAPU8.buffer){
+        node.contents=(bytes as Uint8Array).slice(0,node.usedBytes);
+        result.files++;
+      }
+      result.afterBytes+=node.contents.byteLength;
+    }else if(bytes&&typeof bytes==='object')for(const [name,child]of Object.entries(bytes))visit(child,path+'/'+name);
+  }
+  visit(root,'/wordpress');result.releasedCapacityBytes=result.beforeBytes-result.afterBytes;return result;
+}
