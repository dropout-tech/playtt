@@ -0,0 +1,17 @@
+import type { CloudflarePhaseTrace } from './phase-trace.js';
+
+// Playground retains this callback for later rotation. Its closure must not
+// capture boot-time archives, and a completed request trace must never be reused.
+export function createPlayttRuntimeFactory<T>(createRuntime: () => Promise<T>, initialTrace?: CloudflarePhaseTrace): () => Promise<T> {
+  let pendingTrace=initialTrace;
+  let generation=0;
+  return () => {
+    const trace=pendingTrace;
+    pendingTrace=undefined;
+    const created=trace ? trace.measure('php.runtime.create',createRuntime) : createRuntime();
+    return created.then(runtime=>{
+      console.log(JSON.stringify({schema:'playtt-runtime-generation/v1',generation:++generation}));
+      return runtime;
+    });
+  };
+}
