+function collectCanonicalRuntimePaths(php: PHP, root: string): string[] {
+  const paths: string[] = []
+  const visit = (directory: string): void => {
+    for (const name of php.listFiles(directory)) {
+      if (name === "." || name === "..") continue
+      const path = `${directory}/${name}`
