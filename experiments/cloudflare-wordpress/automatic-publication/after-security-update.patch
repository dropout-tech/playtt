+// Single-site deployments can drain the same committed R2 outbox from a SQLite
+// Durable Object alarm. There is no external queue or client-supplied job key.
+// Keep the upstream exact commit receipt, lease and atomic promotion checks.
+export async function drainPlayttPublication(env: RuntimeEnv, coordinator: RevisionCoordinator, site: SiteContext): Promise<PublicationInvocationEvidence | null> {
+  const jobs = await env.WORDPRESS_STATE_BUCKET.list({ prefix: siteStorageKeys(site).publicationJobPrefix + '/', limit: 1 })
+  const jobKey = jobs.objects[0]?.key
+  if (!jobKey) return null
+  let lease: RevisionLease
+  try { lease = await coordinator.acquire() }
+  catch (error) {
+    if (!(error instanceof RevisionConflict)) throw error
+    return { schema: 'wp-codebox/cloudflare-publication/v1', status: 'pending', jobKey }
+  }
+  try {
+    // Rendering a snapshot must not keep a second PHP WASM instance alive.
+    await discardCachedRuntime(site.id)
+    const result = await drainPublicationJobWhileLeased(env, coordinator, site, jobKey, async () => { lease = await coordinator.renew(lease) })
+    if (!result) throw new Error('Publication outbox entry is invalid or unavailable.')
+    return result
+  } finally { await abortLease(coordinator, site.origin, lease) }
 }
 
