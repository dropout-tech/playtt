 // Isolated probe only: emit bounded phase names, never request data or secrets.
 export function enablePlayttPhaseDiagnostics(): void {
   playttPhaseDiagnostics = true
+}
+
+// Never serialize error names/messages, request paths, query values or headers.
+// These fixed categories distinguish failures while keeping private content out.
+export function playttFailureCategory(error: unknown): string {
+  try {
+    if (!(error instanceof Error)) return 'unknown'
+    const name = error.name, message = error.message
+    if (name === 'RequestBodyReadError') return 'request-body-unavailable'
+    if (name === 'AbortError' || /client disconnected|request (?:was )?aborted|stream (?:was )?cancelled/i.test(message)) return 'client-disconnected'
+    if (/out of memory|memory limit|could not allocate memory/i.test(message)) return 'memory'
+    if (name === 'PHPExecutionFailureError') return 'php-execution'
+    if (name === 'RevisionConflict') return 'coordinator-conflict'
+    if (/integrity|hash|checksum/i.test(message)) return 'integrity'
+    if (error instanceof TypeError) return 'type'
+    if (error instanceof RangeError) return 'range'
+    return 'other'
+  } catch { return 'unknown' }
+}
+
+export function logPlayttRequestFailure(error: unknown, request: Request, summary: PhaseTraceSummary, cleanupFailed: boolean): void {
+  if (!playttPhaseDiagnostics) return
+  const path = new URL(request.url).pathname
+  const endpoint = path === '/wp-admin/admin-ajax.php' ? 'admin-ajax' : path === '/wp-login.php' ? 'login'
+    : path.startsWith('/wp-json/') ? 'rest' : path.startsWith('/wp-admin/') ? 'admin' : 'page'
+  const method = ['GET','HEAD','POST','PUT','PATCH','DELETE','OPTIONS'].includes(request.method) ? request.method : 'OTHER'
+  console.log(JSON.stringify({ schema: 'playtt-request-failure/v1', category: playttFailureCategory(error), endpoint, method,
+    operation: summary.operation, runtime: summary.runtime, phase: [...summary.phases].reverse().find(p => p.evidence?.failed)?.name || 'outside-phase',
+    signalAborted: request.signal.aborted, bodyUsed: request.bodyUsed, cleanupFailed }))
 }
 
